DATACOPILOT_ENVIRONMENT=development
DATACOPILOT_DEBUG=true

DATACOPILOT_APP__NAME=DataPilot-AI
DATACOPILOT_APP__API_PREFIX=/api/v1
DATACOPILOT_APP__HOST=0.0.0.0
DATACOPILOT_APP__PORT=8000
DATACOPILOT_APP__CORS_ORIGINS=["http://localhost:8501"]

DATACOPILOT_PATHS__DATA_DIR=data
DATACOPILOT_PATHS__CHROMADB_DIR=data/chromadb
DATACOPILOT_PATHS__UPLOADS_DIR=data/uploads
DATACOPILOT_PATHS__LOGS_DIR=data/logs
DATACOPILOT_PATHS__CACHE_DIR=data/cache
DATACOPILOT_PATHS__EMBEDDINGS_DIR=data/embeddings
DATACOPILOT_PATHS__TEMP_DIR=data/temp
DATACOPILOT_PATHS__MODELS_DIR=models

DATACOPILOT_RUNTIME__API_ONLY=false
DATACOPILOT_RUNTIME__GPU_ENABLED=false
DATACOPILOT_RUNTIME__CPU_ONLY=true

# 只读查询执行默认关闭。演示前先运行：
# python examples/retail_analytics/setup_demo_db.py --force
DATACOPILOT_QUERY_EXECUTION__ENABLED=false
DATACOPILOT_QUERY_EXECUTION__DATASOURCE_NAME=retail_demo
DATACOPILOT_QUERY_EXECUTION__SQLITE_PATH=data/demo/retail_analytics.db
DATACOPILOT_QUERY_EXECUTION__MAX_ROWS=200
DATACOPILOT_QUERY_EXECUTION__TIMEOUT_MS=3000

DATACOPILOT_LOGGING__LEVEL=INFO
DATACOPILOT_LOGGING__JSON_ENABLED=true
DATACOPILOT_LOGGING__CONSOLE_ENABLED=true
DATACOPILOT_LOGGING__FILE_ENABLED=true
DATACOPILOT_LOGGING__FILE_PATH=data/logs/datacopilot.log
DATACOPILOT_LOGGING__MAX_BYTES=20971520
DATACOPILOT_LOGGING__BACKUP_COUNT=10
DATACOPILOT_LOGGING__REQUEST_ID_HEADER=x-request-id
DATACOPILOT_LOGGING__TRACE_ID_HEADER=x-trace-id

# 运行时只选择一个主模型 provider，避免把模型路由逻辑扩散到业务层。
# 可选：deepseek | openai | ollama
DATACOPILOT_LLM__DEFAULT_PROVIDER=deepseek
DATACOPILOT_LLM__REQUEST_TIMEOUT_SECONDS=60
DATACOPILOT_LLM__MAX_RETRIES=2
DATACOPILOT_LLM__STREAMING_ENABLED=true

DATACOPILOT_EMBEDDINGS__DEFAULT_MODEL=BAAI/bge-m3
DATACOPILOT_EMBEDDINGS__BATCH_SIZE=16
DATACOPILOT_EMBEDDINGS__CACHE_ENABLED=true

DATACOPILOT_DEEPSEEK__ENABLED=true
DATACOPILOT_DEEPSEEK__API_KEY=
DATACOPILOT_DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
DATACOPILOT_DEEPSEEK__CHAT_MODEL=deepseek-chat
DATACOPILOT_DEEPSEEK__TIMEOUT_SECONDS=60
DATACOPILOT_DEEPSEEK__MAX_RETRIES=2

# 兼容现有启动脚本的简写环境变量。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2

DATACOPILOT_OPENAI__ENABLED=false
DATACOPILOT_OPENAI__API_KEY=
DATACOPILOT_OPENAI__BASE_URL=https://api.openai.com/v1
DATACOPILOT_OPENAI__CHAT_MODEL=gpt-4.1-mini
DATACOPILOT_OPENAI__TIMEOUT_SECONDS=60
DATACOPILOT_OPENAI__MAX_RETRIES=2

DATACOPILOT_OLLAMA__ENABLED=false
DATACOPILOT_OLLAMA__BASE_URL=http://127.0.0.1:11434
DATACOPILOT_OLLAMA__CHAT_MODEL=qwen3
DATACOPILOT_OLLAMA__TIMEOUT_SECONDS=120
DATACOPILOT_OLLAMA__KEEP_ALIVE=5m
